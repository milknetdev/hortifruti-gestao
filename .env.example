# ============================================
# Banco de Dados
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hortifruti?schema=public"

# ============================================
# JWT (JSON Web Token)
# ============================================
JWT_SECRET="sua-chave-secreta-muito-segura-aqui-mude-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# Aplicacao
# ============================================
NODE_ENV="development"
PORT=3001
API_PREFIX="api/v1"

# ============================================
# Frontend URL (para CORS)
# ============================================
FRONTEND_URL="http://localhost:3000"

# ============================================
# Redis (Cache e filas)
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="noreply@hortifruti.com"

# ============================================
# Upload de Imagens
# ============================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# ============================================
# Pagamento (Stripe)
# ============================================
STRIPE_SECRET_KEY="sk_test_sua-chave-stripe"
STRIPE_WEBHOOK_SECRET="whsec_seu-webhook-secret"

# ============================================
# Frete (Melhor Envio)
# ============================================
MELHOR_ENVIO_TOKEN="seu-token-melhor-envio"

# ============================================
# Sentry (Monitoramento de erros)
# ============================================
SENTRY_DSN=""

# ============================================
# Prisma
# ============================================
# Shadow database para Prisma Migrate (apenas desenvolvimento)
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hortifruti_shadow?schema=public"
